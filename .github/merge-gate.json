{
  "base_branch": "main",
  "max_file_bytes": 10485760,
  "forbidden_prefixes": [
    "data/",
    "checkpoints/",
    "outputs/"
  ],
  "test_path_prefixes": [
    "src/",
    "scripts/",
    "tests/"
  ],
  "test_exact_paths": [
    "requirements.txt"
  ],
  "required_checks": [
    "PR CI / policy",
    "PR CI / tests"
  ],
  "status_context": "merge-gate/verdict",
  "labels": {
    "ready": "병합-가능",
    "waiting": "병합-대기",
    "blocked": "수정-필요"
  },
  "legacy_labels": [
    "merge-ready",
    "merge-waiting",
    "merge-blocked"
  ]
}
